# ============================================================
#  AgencyFlow — Environment Configuration
#  Copy this file to .env and fill in your values
# ============================================================

# ── SERVER ──────────────────────────────────────────────────
PORT=3000

# ── YOUR AGENCY ─────────────────────────────────────────────
AGENCY_NAME=My Agency
FOUNDER_NAME=Your Name
AGENCY_EMAIL=hello@youragency.com
AGENCY_PHONE=+91XXXXXXXXXX
AGENCY_WEBSITE=www.youragency.com

# ── AI PROVIDER ──────────────────────────────────────────────
# Recommended free option: OpenRouter free models
# AI_PROVIDER values: openrouter | groq | anthropic
AI_PROVIDER=openrouter

# OpenRouter (free models available)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Groq (free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Anthropic (optional paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── EMAIL (Gmail SMTP) ──────────────────────────────────────
# For Gmail: use an App Password (not your real password)
# Go to: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_app_password_here

# ── MESSAGING (Telegram free / Twilio optional) ──────────────
MESSAGING_PROVIDER=telegram

# Telegram bot (free)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twilio (optional paid)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+14155238886
# Your personal WhatsApp number for notifications (with country code)
NOTIFY_WHATSAPP=+91XXXXXXXXXX

# ── DATA STORAGE (Excel local / Google Sheets optional) ──────
# Excel file path (recommended for your use case)
EXCEL_FILE_PATH=./data/leads.xlsx
CLIENT_OUTREACH_FILE_PATH=./data/FreelanceClientOutreach.xlsx
INCOME_FILE_PATH=./data/FreelanceIncomeTracker.xlsx
EXPENSE_FILE_PATH=./data/FreelanceExpenseTracker.xlsx

# Google Sheets optional fallback
GOOGLE_CREDENTIALS_PATH=./data/google-credentials.json

# ── SLACK (optional) ────────────────────────────────────────
# Get an Incoming Webhook URL at: api.slack.com/apps
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
